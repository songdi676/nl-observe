                  "pm.test('code=40401', () => pm.expect(pm.response.json().code).to.eql(40401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/observe/customers/{{customerId}}/traces/{{emptyTraceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "observe", "customers", "{{customerId}}", "traces", "{{emptyTraceId}}"]
            },
            "description": "trace 不存在 → 40401。"
          }
        }
      ]
