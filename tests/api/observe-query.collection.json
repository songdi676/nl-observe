        {
          "name": "异常：运维视图超频（61 次）→ 至少一次 429 code=42901（本组最后执行，会排空限流窗口）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 异步超频用例（Postman/Newman done 回调口径：断言须在 done() 前完成）：",
                  "// 外层请求（本用例自身）须为 200：它已占 1 次配额——若同一 60s 窗口内刚跑过",
                  "// 一轮（桶已排空），外层即 429，后续循环断言前提不成立（评审 n-2）。",
                  "// 时序前提（评审 M-1 同口径）：61 次连续调用须落在同一个 60s 固定窗口内；",
                  "// 服务端 seed IT 已用固定时钟确定化，Newman 侧受部署环境响应速度制约——",
                  "// 慢环境若 61 次内未出现 429，等待窗口过后重跑。",
                  "pm.test('外层请求为 200（占用超频配额 1 次）', () => {",
                  "  pm.expect(pm.response.code, '外层请求即 429：限流桶已被同窗口内的前序执行排空，等待 60s 窗口过后重跑').to.eql(200);",
                  "});",
                  "const TOTAL = 61;",
                  "const url = pm.variables.get('baseUrl') + '/api/observe/metrics/summary?from=' + pm.variables.get('metricsFrom') + '&to=' + pm.variables.get('metricsTo');",
                  "pm.test('运维视图连续 61 次调用触发限流（60 次/分 → 429/42901）', (done) => {",
                  "  const statuses = [];",
                  "  let firstLimitedBody = null;",
                  "  function run(i) {",
                  "    if (i === TOTAL) {",
                  "      try {",
                  "        // 评审 n-1：三条断言先收集后统一抛出——旧写法嵌套 pm.test，外层 pm.expect",
                  "        // 一抛错即静默跳过，失败时恰好丢失 42901 契约证据；收集后失败证据完整",
                  "        const failures = [];",
                  "        const first = statuses.indexOf(429);",
                  "        const tailAll429 = first >= 0 && statuses.slice(first).every((s) => s === 429);",
                  "        const bodyOk = firstLimitedBody !== null && firstLimitedBody.code === 42901;",
                  "        try { pm.expect(first, '61 次内未出现 429：' + JSON.stringify(statuses)).to.satisfy((v) => v >= 0 && v <= 60); } catch (e) { failures.push(String(e.message)); }",
                  "        try { pm.expect(tailAll429, '首个 429 之后同一窗口内应全部拒绝：' + JSON.stringify(statuses)).to.be.true; } catch (e) { failures.push(String(e.message)); }",
                  "        try { pm.expect(bodyOk, '429 响应体统一契约 code=42901（详设 §4.1）').to.be.true; } catch (e) { failures.push(String(e.message)); }",
                  "        if (failures.length > 0) { throw new Error(failures.join(' | ')); }",
                  "      } finally {",
                  "        done();",
                  "      }",
                  "      return;",
                  "    }",
                  "    pm.sendRequest({ url: url, method: 'GET' }, (err, res) => {",
                  "      if (err || !res) { statuses.push(0); }",
                  "      else {",
                  "        statuses.push(res.code);",
                  "        if (res.code === 429 && firstLimitedBody === null) {",
                  "          try { firstLimitedBody = res.json(); } catch (e) { firstLimitedBody = {}; }",
                  "        }",
                  "      }",
                  "      run(i + 1);",
                  "    });",
                  "  }",
                  "  run(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/observe/metrics/summary?from={{metricsFrom}}&to={{metricsTo}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "observe", "metrics", "summary"],
              "query": [
                { "key": "from", "value": "{{metricsFrom}}" },
                { "key": "to", "value": "{{metricsTo}}" }
              ]
            },
            "description": "运维视图限流（详设 §2.4/§4.1：42901/429）。注意：本用例排空 60s 限流窗口，共享环境执行后 1 分钟内其他运维视图调用会收到 429；用例自身前提——61 次调用落在同一 60s 固定窗口（慢环境未现 429 则重跑）、且窗口未被前序执行排空（外层请求断言 200）。"
          }
        }
      ]
    }
  ]
