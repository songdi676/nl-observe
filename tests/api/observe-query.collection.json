    {
      "name": "span（§2.3 单 span 详情）",
      "item": [
        {
          "name": "正常：全字段且 JSON 字段为对象 → 200 code=0",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('code=0', () => pm.expect(body.code).to.eql(0));",
                  "pm.test('span 标识回显', () => {",
                  "  pm.expect(body.data.traceId).to.eql(pm.variables.get('traceId'));",
                  "  pm.expect(body.data.spanId).to.eql(pm.variables.get('spanId'));",
                  "});",
                  "pm.test('全字段存在', () => {",
                  "  for (const k of ['parentSpanId', 'traceState', 'name', 'kind', 'startTime', 'endTime',",
                  "    'statusCode', 'statusMessage', 'bizCode', 'serviceName', 'durationMs', 'effectiveDurationMs']) {",
                  "    pm.expect(body.data).to.have.property(k);",
                  "  }",
                  "});",
                  "pm.test('resource/scope/attributes 解析为对象（非字符串）', () => {",
                  "  pm.expect(body.data.resource).to.be.an('object');",
                  "  pm.expect(body.data.scope).to.be.an('object');",
                  "  pm.expect(body.data.attributes).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/observe/customers/{{customerId}}/traces/{{traceId}}/spans/{{spanId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "observe", "customers", "{{customerId}}", "traces", "{{traceId}}", "spans", "{{spanId}}"]
            },
            "description": "单 span 全字段（详设 §2.3）：attributes_json/resource_json/scope_json 解析为对象。"
          }
        },
