    {
      "name": "businesses（§2.1 业务列表）",
      "item": [
        {
          "name": "正常：from/to 齐全 → 200 code=0 列表字段完整",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('统一响应 {code,message,data}', () => {",
                  "  pm.expect(body).to.have.property('code');",
                  "  pm.expect(body).to.have.property('message');",
                  "  pm.expect(body).to.have.property('data');",
                  "});",
                  "pm.test('code=0', () => pm.expect(body.code).to.eql(0));",
                  "pm.test('data 为数组', () => pm.expect(body.data).to.be.an('array'));",
                  "pm.test('列表元素含 bizId/bizCode/traceId/startTime/effectiveDurationMs/status/endReason', () => {",
                  "  pm.expect(body.data.length).to.be.above(0);",
                  "  for (const item of body.data) {",
                  "    pm.expect(item).to.have.property('bizId');",
                  "    pm.expect(item).to.have.property('bizCode');",
                  "    pm.expect(item).to.have.property('traceId');",
                  "    pm.expect(item).to.have.property('startTime');",
                  "    pm.expect(item).to.have.property('effectiveDurationMs').that.is.a('number');",
                  "    pm.expect(item).to.have.property('status');",
                  "    pm.expect(item).to.have.property('endReason');",
                  "  }",
                  "});",
                  "pm.test('按 startTime 倒序', () => {",
                  "  const ts = body.data.map(i => Date.parse(i.startTime));",
                  "  for (let i = 1; i < ts.length; i++) { pm.expect(ts[i] <= ts[i - 1]).to.be.true; }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/observe/customers/{{customerId}}/businesses?from={{from}}&to={{to}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "observe", "customers", "{{customerId}}", "businesses"],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" }
