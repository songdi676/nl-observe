{
  "info": {
    "_postman_id": "b7f3a2c1-9d4e-4a6b-8c2f-7d1e0a9c4b32",
    "name": "nl-observe query API（T10：业务列表 / span 树 / span 详情）",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "详设 §2.1/§2.2/§2.3 三端点正常+异常用例（Newman 执行）。\n\n前置：目标环境已按预置数据灌入（客户 {{customerId}} 在 [{{from}},{{to}}] 窗口内至少 1 个业务 root span，且存在 trace {{traceId}} / span {{spanId}}）。\n\n运行：newman run tests/api/observe-query.collection.json -e <env.json>\n可覆盖变量：baseUrl（默认 http://localhost:8081）、customerId、traceId、spanId、from、to、bizCode、emptyCustomerId、emptyTraceId、emptySpanId。\n\n断言口径：统一 {code,message,data}（§4.1）；参数错误 400/40001；无数据 404/40401。"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081", "type": "string" },
    { "key": "customerId", "value": "c-1", "type": "string" },
    { "key": "traceId", "value": "t-1", "type": "string" },
    { "key": "spanId", "value": "s-root", "type": "string" },
    { "key": "from", "value": "2026-09-01", "type": "string" },
    { "key": "to", "value": "2026-09-30", "type": "string" },
    { "key": "bizCode", "value": "ORDER", "type": "string" },
    { "key": "emptyCustomerId", "value": "c-no-such-customer", "type": "string" },
    { "key": "emptyTraceId", "value": "ffffffffffffffffffffffffffffffff", "type": "string" },
    { "key": "emptySpanId", "value": "ffffffffffffffff", "type": "string" }
  ],
  "item": [
    {
      "name": "businesses（§2.1 业务列表）",
      "item": [
        {
          "name": "正常：from/to 齐全 → 200 code=0 列表字段完整",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('统一响应 {code,message,data}', () => {",
                  "  pm.expect(body).to.have.property('code');",
                  "  pm.expect(body).to.have.property('message');",
                  "  pm.expect(body).to.have.property('data');",
                  "});",
                  "pm.test('code=0', () => pm.expect(body.code).to.eql(0));",
                  "pm.test('data 为数组', () => pm.expect(body.data).to.be.an('array'));",
                  "pm.test('列表元素含 bizId/bizCode/traceId/startTime/effectiveDurationMs/status/endReason', () => {",
                  "  pm.expect(body.data.length).to.be.above(0);",
                  "  for (const item of body.data) {",
                  "    pm.expect(item).to.have.property('bizId');",
                  "    pm.expect(item).to.have.property('bizCode');",
                  "    pm.expect(item).to.have.property('traceId');",
                  "    pm.expect(item).to.have.property('startTime');",
                  "    pm.expect(item).to.have.property('effectiveDurationMs').that.is.a('number');",
                  "    pm.expect(item).to.have.property('status');",
                  "    pm.expect(item).to.have.property('endReason');",
                  "  }",
                  "});",
                  "pm.test('按 startTime 倒序', () => {",
                  "  const ts = body.data.map(i => Date.parse(i.startTime));",
                  "  for (let i = 1; i < ts.length; i++) { pm.expect(ts[i] <= ts[i - 1]).to.be.true; }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/observe/customers/{{customerId}}/businesses?from={{from}}&to={{to}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "observe", "customers", "{{customerId}}", "businesses"],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" }
              ]
            },
            "description": "详设 §2.1：业务 root span（name LIKE 'biz.business.%'）列表，start_time 倒序，LIMIT 200。"
          }
        },
        {
          "name": "正常：bizCode 过滤 → 200 code=0 仅命中该 bizCode",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('code=0', () => pm.expect(body.code).to.eql(0));",
                  "pm.test('全部命中 bizCode', () => {",
                  "  pm.expect(body.data.length).to.be.above(0);",
                  "  for (const item of body.data) { pm.expect(item.bizCode).to.eql(pm.variables.get('bizCode')); }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/observe/customers/{{customerId}}/businesses?from={{from}}&to={{to}}&bizCode={{bizCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "observe", "customers", "{{customerId}}", "businesses"],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" },
                { "key": "bizCode", "value": "{{bizCode}}" }
              ]
            },
            "description": "哨兵过滤 ('' = :bizCode OR biz_code = :bizCode)：指定 bizCode 时仅返回该业务。"
          }
