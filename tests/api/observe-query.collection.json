              "host": ["{{baseUrl}}"],
              "path": ["api", "observe", "customers", "{{customerId}}", "traces", "{{emptyTraceId}}", "spans", "{{spanId}}"]
            },
            "description": "(customerId, traceId, spanId) 三元组精确匹配：span 存在但 trace 不符 → 40401。"
          }
        }
