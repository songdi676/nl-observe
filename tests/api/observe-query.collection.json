    {
      "name": "trace（§2.2 span 树）",
      "item": [
        {
          "name": "正常：span 树含白名单属性与 events 字段 → 200 code=0",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('code=0', () => pm.expect(body.code).to.eql(0));",
                  "pm.test('data.traceId 回显', () => pm.expect(body.data.traceId).to.eql(pm.variables.get('traceId')));",
                  "pm.test('data.spans 非空数组', () => {",
                  "  pm.expect(body.data.spans).to.be.an('array').that.is.not.empty;",
                  "});",
                  "pm.test('span 节点字段完整（含 attributes 对象与 events 数组）', () => {",
                  "  for (const s of body.data.spans) {",
                  "    pm.expect(s).to.have.property('spanId');",
                  "    pm.expect(s).to.have.property('parentSpanId');",
                  "    pm.expect(s).to.have.property('name');",
                  "    pm.expect(s).to.have.property('kind').that.is.a('number');",
                  "    pm.expect(s).to.have.property('startTime');",
                  "    pm.expect(s).to.have.property('endTime');",
                  "    pm.expect(s).to.have.property('statusCode').that.is.a('number');",
                  "    pm.expect(s).to.have.property('durationMs').that.is.a('number');",
                  "    pm.expect(s).to.have.property('effectiveDurationMs').that.is.a('number');",
                  "    pm.expect(s.attributes).to.be.an('object');",
                  "    pm.expect(s.events).to.be.an('array');",
                  "  }",
                  "});",
                  "pm.test('REST span 白名单属性透出（http.* / nl.duration_ms）', () => {",
                  "  const rest = body.data.spans.filter(s => s.attributes['http.request.method'] !== undefined);",
                  "  for (const s of rest) {",
                  "    pm.expect(s.attributes).to.have.property('http.route');",
                  "    pm.expect(s.attributes).to.have.property('http.response.status_code');",
                  "    pm.expect(s.attributes).to.have.property('nl.duration_ms');",
                  "  }",
                  "});",
                  "pm.test('按 startTime 正序', () => {",
                  "  const ts = body.data.spans.map(s => Date.parse(s.startTime));",
                  "  for (let i = 1; i < ts.length; i++) { pm.expect(ts[i] >= ts[i - 1]).to.be.true; }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/observe/customers/{{customerId}}/traces/{{traceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "observe", "customers", "{{customerId}}", "traces", "{{traceId}}"]
            },
            "description": "FINAL 查询全 span（详设 §2.2），平铺 spans 带 parentSpanId，前端建树。"
          }
        },
        {
          "name": "异常：trace 无数据 → 404 code=40401",
          "event": [
