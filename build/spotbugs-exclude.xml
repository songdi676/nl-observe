<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs 排除过滤器（T02 质量门：0 高危/中危）。
  DTO/OTLP 模型是数据载体（Jackson 反序列化直接持有引用），EI_EXPOSE_REP 系列不适用。
-->
<FindBugsFilter>
  <Match>
    <Package name="~com\.nlolobserve\.common\.(dto|model)"/>
    <Bug code="EI, EI2"/>
  </Match>
  <Match>
    <Class name="com.nlolobserve.common.web.ApiResult"/>
    <Bug code="EI, EI2"/>
  </Match>
  <!--
    T04/T05：Spring DI 构造注入有意持有单例 bean 引用
    （Vertx/Instrumentation/OtlpProperties/KafkaExporterProperties 为共享单例，复制即错），
    EI_EXPOSE_REP2 误报。
  -->
  <Match>
    <Or>
      <Class name="com.nlolobserve.receiver.collector.ContextSafeTracesCollector"/>
      <Class name="com.nlolobserve.receiver.collector.ContextSafeMetricsCollector"/>
      <Class name="com.nlolobserve.receiver.collector.ContextSafeLogsCollector"/>
      <Class name="com.nlolobserve.receiver.collector.EmbeddedCollectorConfig"/>
      <Class name="com.nlolobserve.receiver.web.ProducerConfigController"/>
    </Or>
    <Method name="&lt;init&gt;"/>
    <Bug code="EI2"/>
  </Match>
  <!--
    T07：storage 三 consumer 构造注入仓库/BatchWriteSupport 单例 bean
    （Spring DI 有意共享引用，复制即错），EI_EXPOSE_REP2 误报。
  -->
  <Match>
    <Or>
      <Class name="com.nlolobserve.storage.consumer.TracesConsumer"/>
      <Class name="com.nlolobserve.storage.consumer.MetricsConsumer"/>
      <Class name="com.nlolobserve.storage.consumer.LogsConsumer"/>
    </Or>
    <Method name="&lt;init&gt;"/>
    <Bug code="EI2"/>
  </Match>
  <!--
    T09：query 模块 Spring DI 构造注入有意持有单例 bean 引用
    （NamedParameterJdbcTemplate/ObjectMapper/JdbcTemplate 及 service/repo 为共享单例，
    复制即错），EI_EXPOSE_REP2 误报（同 T04 receiver 口径）。
  -->
  <Match>
    <Or>
      <Class name="com.nlolobserve.query.repo.QueryRepository"/>
      <Class name="com.nlolobserve.query.config.DatabendStartupCheck"/>
      <Class name="com.nlolobserve.query.service.BusinessQueryService"/>
      <Class name="com.nlolobserve.query.service.SpanTreeService"/>
      <Class name="com.nlolobserve.query.service.MetricSummaryService"/>
      <Class name="com.nlolobserve.query.service.OpsViewRateLimiter"/>
      <Class name="com.nlolobserve.query.web.BusinessesController"/>
      <Class name="com.nlolobserve.query.web.TracesController"/>
      <Class name="com.nlolobserve.query.web.MetricsController"/>
    </Or>
    <Method name="&lt;init&gt;"/>
    <Bug code="EI2"/>
  </Match>
</FindBugsFilter>
