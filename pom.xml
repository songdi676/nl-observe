<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- T04 开工前置项（T01 poc-notes §1 / 评审 A06）：3.3.x 已过 OSS 补丁支持期，
         升到私服可用的 SB3 最新受支持线（3.5.x）；netty/otel 覆盖属性见 properties 注释 -->
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.nlolobserve</groupId>
  <artifactId>nl-observe</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>nl-observe</name>
  <description>前端透明化建设：单仓库多模块（common 单向依赖，三后端彼此不互依）</description>

  <modules>
    <module>backend-observe-common</module>
    <module>backend-observe-receiver</module>
    <!-- 覆盖率聚合模块：必须保持在最后，report-aggregate 依赖前面模块的 exec 产物 -->
    <module>backend-observe-coverage</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <checkstyle-plugin.version>3.1.2</checkstyle-plugin.version>
    <checkstyle.version>8.45</checkstyle.version>
    <spotbugs-plugin.version>4.7.3.6</spotbugs-plugin.version>
    <jacoco-plugin.version>0.8.12</jacoco-plugin.version>
    <dependency-check-plugin.version>12.1.0</dependency-check-plugin.version>
    <!-- T04：collector-embedded 1.2.1（T01 poc-notes §1 锁定坐标） -->
    <collector-embedded.version>1.2.1</collector-embedded.version>
    <!-- T04：覆盖 spring-boot-dependencies 的 netty 4.1.x 版本属性——
         collector-embedded 的 Vert.x 5.1.8 运行依赖 netty 4.2.x（T01 版本矩阵），
         沿用 Spring Boot 的 4.1.x 会在 Vert.x 启动时触发类/方法不兼容 -->
    <netty.version>4.2.18.Final</netty.version>
    <!-- T04：与 collector-embedded 1.2.1 parent 锁定的 opentelemetry-api 对齐（覆盖 SB 3.5 管理的旧版本） -->
    <opentelemetry.version>1.65.0</opentelemetry.version>
    <!-- T03：显式导入 testcontainers-bom：Spring Boot 3.3.5 BOM 的 1.19.8 未收录 databend 模块
         （1.20.0 起才有），统一升到内网镜像可用的 1.21.4（覆盖 SB BOM 对 testcontainers 的版本管理） -->
    <testcontainers.version>1.21.4</testcontainers.version>
    <!-- T03：Databend JDBC 驱动：仅测试用（Testcontainers Databend 集成测试 T03/T08）。
         版本以内网镜像（.mvn/settings.xml）实际可用为准 -->
    <databend-jdbc.version>0.4.8</databend-jdbc.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.nlolobserve</groupId>
        <artifactId>backend-observe-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.mishmash.opentelemetry</groupId>
        <artifactId>collector-embedded</artifactId>
        <version>${collector-embedded.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${checkstyle-plugin.version}</version>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${checkstyle.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <configLocation>${maven.multiModuleProjectDirectory}/build/AliCheckStyle.xml</configLocation>
            <consoleOutput>true</consoleOutput>
            <failsOnError>true</failsOnError>
            <violationSeverity>warning</violationSeverity>
            <includeTestSourceDirectory>false</includeTestSourceDirectory>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>${spotbugs-plugin.version}</version>
          <configuration>
            <effort>Max</effort>
            <threshold>Medium</threshold>
            <xmlOutput>true</xmlOutput>
            <excludeFilterFile>${maven.multiModuleProjectDirectory}/build/spotbugs-exclude.xml</excludeFilterFile>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-plugin.version}</version>
          <!-- rules 置于 plugin 级：使绑定执行与 CLI 直跑（质量门口径
               mvn test jacoco:report jacoco:check）共用同一 80% 行覆盖阈值；
               仅放 execution 内时 default-cli 执行无 rules，CLI 直跑 check 会报错 -->
          <configuration>
            <rules>
              <rule>
                <element>BUNDLE</element>
                <limits>
                  <limit>
                    <counter>LINE</counter>
                    <value>COVEREDRATIO</value>
                    <minimum>0.80</minimum>
                  </limit>
                </limits>
              </rule>
            </rules>
          </configuration>
          <executions>
            <execution>
              <id>prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>report</id>
              <phase>test</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
            <execution>
              <id>check</id>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <!-- 安全门：mvn dependency-check:check（质量门脚本与 CI 同命令）。
             failBuildOnCVSS=7 → 高危（CVSS≥7.0）即构建失败，对应门阈值"无高危漏洞"。 -->
        <plugin>
          <groupId>org.owasp</groupId>
          <artifactId>dependency-check-maven</artifactId>
          <version>${dependency-check-plugin.version}</version>
          <configuration>
            <failBuildOnCVSS>7</failBuildOnCVSS>
            <formats>
              <format>HTML</format>
              <format>JSON</format>
            </formats>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- 声明于根 build/plugins：使 mvn dependency-check:check 的 goal 前缀解析
           无需下载 group 级 maven-metadata（离线/镜像抖动时仍可解析到本仓库已固定版本） -->
      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
