{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2020", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@nl-observe/sdk-web": ["./sdk-web/src/index.ts"],
      "@nl-observe/sdk-web/vue3": ["./sdk-web/src/vue3.ts"]
    }
  },
  "include": [
    "vitest.config.ts",
    "poc/sdk-vue2-init/src",
    "poc/sdk-vue2-init/test",
    "poc/sdk-vue3-init/src",
    "poc/sdk-vue3-init/test",
    "poc/micro-app-capture/src",
    "poc/micro-app-capture/test",
    "poc/micro-app-capture/app",
    "sdk-web/src",
    "sdk-web/test/dist-loads.spec.ts",
    "sdk-web/test/core.spec.ts",
    "sdk-web/test/business.spec.ts",
    "sdk-web/test/flush.spec.ts",
    "sdk-web/test/rest.spec.ts",
    "sdk-web/test/export.spec.ts",
    "sdk-web/test/vue2-host",
    "sdk-web/test/vue3-host"
  ]
}
