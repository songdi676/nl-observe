<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.nlolobserve</groupId>
    <artifactId>nl-observe</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>backend-observe-common</artifactId>
  <name>backend-observe-common</name>
  <description>三后端共享契约：DDL 常量 / DTO / OTLP 模型 / 统一响应 / 错误码（被 receiver/storage/query 单向依赖）</description>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- T03：Testcontainers Databend 集成测试（执行 001-init.sql）。
         镜像不可得/Docker 不可用时用例按 assumption 跳过（详细设计 §测试策略 env-gated） -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>databend</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.databend</groupId>
      <artifactId>databend-jdbc</artifactId>
      <version>${databend-jdbc.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <!-- T04 起：本模块报告落位模块自身 target/；仓库根 target/site/jacoco/jacoco.csv
             （质量门读取处）由 backend-observe-coverage 的 report-aggregate 聚合产出，
             避免多模块直接写根目录互相覆盖。 -->
      </plugin>
    </plugins>
  </build>
</project>
