<?xml version="1.0" encoding="UTF-8"?>
<!--
  T07：storage Spring Boot 骨架 + 三 Kafka consumer（详设 §1.3）。
  三独立 batch listener（traces/metrics/logs，消费组 observe.kafka.consumer-group=nl-observe-storage），
  写库成功后才提交 offset（at-least-once）；写失败重试 3 次（带退避）后 error 日志 + 跳过该批不提交。
  T08：OTLP/JSON 解析（parse/）+ 三表 JDBC 命名参数 REPLACE INTO batch 写入（repo/，500/批）
  + Databend 数据源/启动自检（config/，presigned_url_disabled 精确匹配 + SELECT 1 fail-fast）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.nlolobserve</groupId>
    <artifactId>nl-observe</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>backend-observe-storage</artifactId>
  <name>backend-observe-storage</name>
  <description>OTLP 消费端：三 Kafka consumer（traces/metrics/logs）写 Databend（T07 骨架）</description>

  <dependencies>
    <dependency>
      <groupId>com.nlolobserve</groupId>
      <artifactId>backend-observe-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <!-- T08：JdbcTemplate/NamedParameterJdbcTemplate + HikariCP（详设 §1.3 repo/：三表 JDBC batch 写入） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Testcontainers Kafka/Databend 集成测试（env-gated：Docker/镜像不可得时按 assumption 跳过，详设 §6.2） -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>databend</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- T08：Databend JDBC 驱动 runtime scope（同 T09 评审 M1 口径）：
         存储端是运行时依赖该驱动的服务，test scope 下 fat-jar 缺驱动 →
         java -jar 启动 "No suitable driver"、启动自检误导性 fail-fast -->
    <dependency>
      <groupId>com.databend</groupId>
      <artifactId>databend-jdbc</artifactId>
      <version>${databend-jdbc.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
