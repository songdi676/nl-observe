<?xml version="1.0" encoding="UTF-8"?>
<!--
  T09：审计日志独立落盘（详设 §1.4 验收：AuditLogFilter 记录至独立 audit 日志文件）。
  logger "AUDIT"（web.AuditLogFilter）绑定专用 RollingFileAppender，additivity=false
  使审计行不混入控制台/业务日志；文件路径经 logging.audit.file 配置（默认 logs/audit/audit.log）。
-->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

  <springProperty scope="context" name="AUDIT_FILE" source="logging.audit.file"
                  defaultValue="logs/audit/audit.log"/>

  <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${AUDIT_FILE}</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${AUDIT_FILE}.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>90</maxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %msg%n</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <logger name="AUDIT" level="INFO" additivity="false">
    <appender-ref ref="AUDIT_FILE"/>
  </logger>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
