    "@vitest/coverage-v8": "5.0.4",
    "eslint": "^9.0.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "5.0.4",
    "vue-tsc": "^2.2.0"
  }
}
