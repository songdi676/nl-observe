{
  "name": "nl-observe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "nl-observe 单仓根：聚合前端工程（npm workspaces），供 scripts/quality-gate.sh --scope frontend/all 在仓库根执行。注：sdk-web/test/vue2-host、vue3-host 为独立 npm 工程（非 workspace 成员）——npm 11.20 实测对「workspace 目录内嵌套 workspace」不落地嵌套 node_modules，vue2/vue3 双版本无法正确共存；宿主在各自目录 npm ci 安装，根 vitest projects 仍聚合其用例，质量门口径不变。",
  "workspaces": [
    "poc/sdk-vue2-init",
    "poc/sdk-vue3-init",
    "poc/micro-app-capture",
    "sdk-web",
    "tests/e2e/host"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:local": "node tests/e2e/support/run-local.mjs"
  },
  "overrides": {
    "vue-template-compiler": "^2.7.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "^9.0.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "5.0.4",
    "vue-tsc": "^2.2.0",
    "@playwright/test": "1.64.1",
    "globals": "^14.0.0"
  }
}
