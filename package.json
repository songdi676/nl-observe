{
  "name": "nl-observe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "nl-observe 单仓根：聚合前端工程（npm workspaces），供 scripts/quality-gate.sh --scope frontend/all 在仓库根执行",
  "workspaces": [
    "poc/sdk-vue2-init",
    "poc/sdk-vue3-init"
